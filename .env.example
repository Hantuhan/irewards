# App
NEXT_PUBLIC_APP_URL=http://localhost:3002
# SaaS apex for merchant subdomains (cafe1.irewards.store). Local uses {sub}.localhost.
NEXT_PUBLIC_APEX_DOMAIN=irewards.store

# --- Database provider ---
# Default: insforge (local npm run insforge:up, Zeabur Docker production)
# Optional: supabase — DATABASE_PROVIDER=supabase

# iRewards InsForge (local dedicated instance — see npm run insforge:setup)
NEXT_PUBLIC_INSFORGE_URL=http://localhost:7230
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_URL=http://localhost:7230
INSFORGE_API_KEY=

# Supabase (Zeabur production — PostgREST + direct Postgres for migrations)
# Project Settings → API: SUPABASE_URL + service_role key
# Project Settings → Database: direct connection string (port 5432, not pooler)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Optional direct Postgres — Supabase (direct :5432) or local InsForge (:55532)
# Used by /api/health/db and npm run db:migrate:supabase
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:55532/irewards
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=true
DATABASE_URL=

# Meta WhatsApp Cloud API (WhatsApp Business Platform)
# From Meta for Developers → your app. See docs/WHATSAPP_SETUP.md for the
# full walkthrough, including the Tech Provider steps Meta requires.
#
# --- Required: every merchant connects their own WhatsApp account ---
# These four are what make the "Connect WhatsApp" button in
# Settings → WhatsApp work. Without META_EMBEDDED_SIGNUP_CONFIG_ID the button
# tells the merchant the server is not configured, and nobody can connect.
META_APP_ID=                  # your Meta app id; also used to upload template image headers
META_APP_SECRET=              # validates X-Hub-Signature-256 on /api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=    # any secret string; paste the same value in the Meta webhook config
META_EMBEDDED_SIGNUP_CONFIG_ID=   # Meta app → WhatsApp → Embedded Signup → configuration id

# Encrypts merchant WhatsApp tokens at rest (AES-256-GCM).
# Falls back to MERCHANT_SESSION_SECRET if unset, which is why it matters:
# rotating MERCHANT_SESSION_SECRET would silently orphan every stored token and
# force all merchants to reconnect. Set this explicitly so the two can rotate
# apart. If you already have connected merchants and never set this, set it to
# your CURRENT MERCHANT_SESSION_SECRET value — anything else locks them out.
WHATSAPP_TOKEN_KEY=

# --- Optional: the shared platform number, for pilots only ---
# Off unless WHATSAPP_ALLOW_PLATFORM_FALLBACK=true. When on, a merchant who has
# not connected their own account sends on this number instead of being asked
# to connect. One bad sender then drags down the quality rating for everyone
# on it, so turn this on deliberately for a named pilot and turn it back off.
# WHATSAPP_ALLOW_PLATFORM_FALLBACK=false
META_ACCESS_TOKEN=            # permanent System User token with whatsapp_business_messaging + whatsapp_business_management
META_WABA_ID=                 # WhatsApp Business Account id (templates + approvals live here)
META_PHONE_NUMBER_ID=         # sender phone number id (not the phone number itself)

META_GRAPH_VERSION=v21.0

# Cron (automation jobs — review nudge, churn, campaign sends)
# REQUIRED. Never use the old "irewards-dev-cron" value in production.
CRON_SECRET=

# Payments
# Local: PAYMENT_PROVIDER=dev
# Production: chip (default) or hitpay.
#
# chip   — CHIP Collect, the cheaper option for cafe-sized tickets: DuitNow QR
#          1.0%, e-wallets 1.4%, cards 1.0-2.0% with no flat per-card fee.
#          MYR only. Needs PAYMENT_API_KEY + CHIP_BRAND_ID. Callbacks are
#          verified against CHIP's public key, so there is no salt to set.
# hitpay — Still here because it is the only one that settles SGD, and because
#          its flat RM1 card fee stops mattering on a large average ticket.
#          Needs PAYMENT_API_KEY + PAYMENT_SALT.
PAYMENT_PROVIDER=dev
PAYMENT_API_KEY=

# CHIP (PAYMENT_PROVIDER=chip)
# Brand ID: https://portal.chip-in.asia/collect/developers/brands
# A test API key from the same portal puts purchases in test mode; there is no
# separate sandbox host, so CHIP_API_BASE rarely needs setting.
CHIP_BRAND_ID=
# CHIP_API_BASE=https://gate.chip-in.asia/api/v1

# HitPay (PAYMENT_PROVIDER=hitpay)
PAYMENT_SALT=
PAYMENT_WEBHOOK_SECRET=
HITPAY_API_BASE=https://api.sandbox.hit-pay.com/v1

# Dev helpers — MUST be unset / false in production
# Log WhatsApp sends instead of calling Meta, and simulate template review locally.
# Do NOT couple this to PAYMENT_PROVIDER — set WHATSAPP_SKIP_SEND=false when Meta is live.
WHATSAPP_SKIP_SEND=true
# Skip Meta webhook HMAC (local only; ignored when NODE_ENV=production)
META_SKIP_VERIFY=true

# Optional Meta template for redeem OTP (auth/utility). Body params: {{1}}=code, {{2}}=cafe name.
# Without this, free-form text is used (24h window) or logged in WHATSAPP_SKIP_SEND mode.
# META_REDEEM_OTP_TEMPLATE=
# META_REDEEM_OTP_TEMPLATE_LANG=en

# Docker note: docker-compose.yml / docker-compose.dev.yml load .env.local.
# For a production container, use a production env file with secrets set and
# WHATSAPP_SKIP_SEND / META_SKIP_VERIFY omitted or false.

# Platform SaaS admin (/platform) — MUST meet complexity (12+ upper/lower/digit/special)
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SESSION_SECRET=

# Merchant admin header bypass (optional). In development, also requires
# ALLOW_INSECURE_MERCHANT_ADMIN=true if MERCHANT_ADMIN_SECRET is unset.
MERCHANT_ADMIN_SECRET=
ALLOW_INSECURE_MERCHANT_ADMIN=

# DeepSeek AI (merchant setup agent, campaign copy, store intelligence)
# Keep in Zeabur Variables / .env.local only — never commit.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
