# App
NEXT_PUBLIC_APP_URL=http://localhost:3002
# SaaS apex for merchant subdomains (cafe1.irewards.store). Local uses {sub}.localhost.
NEXT_PUBLIC_APEX_DOMAIN=irewards.store

# --- Database provider ---
# Local dev (default): insforge — npm run insforge:up
# Zeabur production: supabase — see docs/ZEABUR.md and npm run zeabur:setup
# DATABASE_PROVIDER=insforge
# DATABASE_PROVIDER=supabase

# iRewards InsForge (local dedicated instance — see npm run insforge:setup)
NEXT_PUBLIC_INSFORGE_URL=http://localhost:7230
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_URL=http://localhost:7230
INSFORGE_API_KEY=

# Supabase (Zeabur production — PostgREST + direct Postgres for migrations)
# Project Settings → API: SUPABASE_URL + service_role key
# Project Settings → Database: direct connection string (port 5432, not pooler)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Optional direct Postgres — Supabase (direct :5432) or local InsForge (:55532)
# Used by /api/health/db and npm run db:migrate:supabase
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:55532/irewards
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=true
DATABASE_URL=

# Meta WhatsApp Cloud API (WhatsApp Business Platform)
# From Meta for Developers → your app → WhatsApp → API setup.
META_ACCESS_TOKEN=            # permanent System User token with whatsapp_business_messaging + whatsapp_business_management
META_WABA_ID=                 # WhatsApp Business Account id (templates + approvals live here)
META_PHONE_NUMBER_ID=         # sender phone number id (not the phone number itself)
META_APP_ID=                  # needed to upload image headers for templates
META_APP_SECRET=              # validates X-Hub-Signature-256 on /api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=    # any secret string; paste the same value in the Meta webhook config
META_GRAPH_VERSION=v21.0

# Cron (automation jobs — review nudge, churn, campaign sends)
# REQUIRED. Never use the old "irewards-dev-cron" value in production.
CRON_SECRET=

# Payments
# Local: PAYMENT_PROVIDER=dev
# Production: PAYMENT_PROVIDER=hitpay + real PAYMENT_API_KEY / PAYMENT_SALT / PAYMENT_WEBHOOK_SECRET
PAYMENT_PROVIDER=dev
PAYMENT_API_KEY=
PAYMENT_SALT=
PAYMENT_WEBHOOK_SECRET=
HITPAY_API_BASE=https://api.sandbox.hit-pay.com/v1

# Dev helpers — MUST be unset / false in production
# Log WhatsApp sends instead of calling Meta, and simulate template review locally.
# Do NOT couple this to PAYMENT_PROVIDER — set WHATSAPP_SKIP_SEND=false when Meta is live.
WHATSAPP_SKIP_SEND=true
# Skip Meta webhook HMAC (local only; ignored when NODE_ENV=production)
META_SKIP_VERIFY=true

# Docker note: docker-compose.yml / docker-compose.dev.yml load .env.local.
# For a production container, use a production env file with secrets set and
# WHATSAPP_SKIP_SEND / META_SKIP_VERIFY omitted or false.

# Platform SaaS admin (/platform) — MUST meet complexity (12+ upper/lower/digit/special)
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SESSION_SECRET=

# Merchant admin header bypass (optional). In development, also requires
# ALLOW_INSECURE_MERCHANT_ADMIN=true if MERCHANT_ADMIN_SECRET is unset.
MERCHANT_ADMIN_SECRET=
ALLOW_INSECURE_MERCHANT_ADMIN=

# DeepSeek AI (merchant setup agent, campaign copy, store intelligence)
# Keep in Zeabur Variables / .env.local only — never commit.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
