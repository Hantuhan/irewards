# Supabase + Cloudflare — copy to .env.supabase (gitignored) for setup script.
# Use the *direct* Postgres URL (port 5432), not the pooler, for Hyperdrive.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# App reads these when DATABASE_PROVIDER=supabase
DATABASE_PROVIDER=supabase
DATABASE_SSL=true
