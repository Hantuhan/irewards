# Zeabur production — InsForge + iRewards app (see zeabur-template.yaml)
# Copy to .env.zeabur (gitignored) for local prod docker test.

NODE_ENV=production
PORT=8080
DATABASE_PROVIDER=insforge
RUN_MIGRATIONS=true

NEXT_PUBLIC_APP_URL=https://irewards.store
NEXT_PUBLIC_APEX_DOMAIN=irewards.store

# InsForge API (Zeabur internal hostname or http://host.docker.internal:7230 locally)
INSFORGE_URL=http://insforge:7130
NEXT_PUBLIC_INSFORGE_URL=https://irewards.store
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_API_KEY=

# Postgres — same DB as InsForge stack
INSFORGE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres:5432/irewards

MERCHANT_SESSION_SECRET=
MEMBER_SESSION_SECRET=
CRON_SECRET=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SESSION_SECRET=

PAYMENT_PROVIDER=chip
PAYMENT_API_KEY=
# CHIP: https://portal.chip-in.asia/collect/developers/brands
CHIP_BRAND_ID=

# Only for PAYMENT_PROVIDER=hitpay (SGD merchants, or a large average ticket).
# PAYMENT_SALT=
# PAYMENT_WEBHOOK_SECRET=
# HITPAY_API_BASE=https://api.hit-pay.com/v1

# Required — these four are what let a merchant connect their own WhatsApp
# account in Settings → WhatsApp. See docs/WHATSAPP_SETUP.md.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Encrypts merchant WhatsApp tokens. If merchants are already connected and
# this was never set, use your current MERCHANT_SESSION_SECRET value here.
WHATSAPP_TOKEN_KEY=

# Optional shared pilot number. Leave the fallback off unless you mean it —
# with it on, merchants who never connect send on one shared reputation.
# WHATSAPP_ALLOW_PLATFORM_FALLBACK=false
META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=

META_GRAPH_VERSION=v21.0

WHATSAPP_SKIP_SEND=false
META_SKIP_VERIFY=false
