# Zeabur production — paste into Zeabur → Service → Variables (or bind as env file).
# Database: Supabase (recommended). Run migrations first: npm run zeabur:setup

NODE_ENV=production
PORT=8080

NEXT_PUBLIC_APP_URL=https://irewards.store
NEXT_PUBLIC_APEX_DOMAIN=irewards.store

DATABASE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true

MERCHANT_SESSION_SECRET=
MEMBER_SESSION_SECRET=
CRON_SECRET=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SESSION_SECRET=

PAYMENT_PROVIDER=hitpay
PAYMENT_API_KEY=
PAYMENT_SALT=
PAYMENT_WEBHOOK_SECRET=
HITPAY_API_BASE=https://api.hit-pay.com/v1

META_ACCESS_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Unset or false in production
WHATSAPP_SKIP_SEND=false
META_SKIP_VERIFY=false

# Optional — AI features (keep in Zeabur secrets only)
# DEEPSEEK_API_KEY=
