{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irewards",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "irewards"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    // Public only — never put DEEPSEEK_API_KEY, Meta, HitPay, or DB passwords here.
    // Those belong in `.env.local` (local) or `wrangler secret put` (Cloudflare), never in git.
    "NEXT_PUBLIC_APEX_DOMAIN": "irewards.store"
  },
  // After creating Hyperdrive against Supabase direct :5432:
  //   sh scripts/cf-supabase-setup.sh
  // Or: npx wrangler hyperdrive create irewards-supabase --connection-string="$SUPABASE_DB_URL"
  // Then paste the id below and uncomment.
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "REPLACE_WITH_HYPERDRIVE_ID",
  //     "localConnectionString": "postgresql://postgres:PASSWORD@127.0.0.1:55532/irewards"
  //   }
  // ],
  // App data on Workers uses Supabase PostgREST (DATABASE_PROVIDER=supabase secrets).
  // Hyperdrive is for direct SQL (/api/health/db, future SQL paths).
}
